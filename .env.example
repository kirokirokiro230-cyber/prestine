# Copy to .env.local and fill in. Never commit .env.local.
#
# Every command reads .env.local, then .env, and a real environment variable beats
# both — see scripts/env.ts.
#
# ---------------------------------------------------------------------------
# First run, in order
# ---------------------------------------------------------------------------
#
#   1. Run the migrations in supabase/migrations/ against your Supabase project
#      (see supabase/README.md) — this creates every table and seeds the starter
#      taxonomy, promo codes, email copy and hero banners.
#   2. Create a PUBLIC storage bucket, named to match SUPABASE_STORAGE_BUCKET below.
#   3. npm run dev
#   4. open /admin/setup     create the first owner and choose its password
#
# Step 4 is deliberately not automated: a seeded password would live in the repo, in
# your shell history and in the deploy log, and nobody ever changes it. The setup
# screen locks itself as soon as one account exists.

# ---------------------------------------------------------------------------
# Supabase — required. This is the only data store the app uses: Postgres for
# every table, Storage for every uploaded image.
# ---------------------------------------------------------------------------

# Your project's REST endpoint, from Project Settings → API → Project URL.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Create a PUBLIC bucket (Storage → New bucket) and name it here.
#
# Public because product photos are public: making the bucket private would mean
# signing every URL, which breaks CDN caching and next/image for no security gain.
SUPABASE_STORAGE_BUCKET=product-images

# The service-role key, NOT the anon key.
#
# Server-only — it bypasses row-level security. It must never appear in a
# NEXT_PUBLIC_* variable, be imported into a client component, or be committed. If it
# leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=

# The anon (public) key. Safe to expose to the browser — Row Level Security policies
# on every table decide what it can actually read or write, not this key's secrecy.
#
# From: Project Settings → API → Project API keys → anon / public.
#
# Not currently used by any browser code — every read/write goes through a server
# action — but reserved for the day a client component queries Supabase directly.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Signs admin session cookies. Sessions are stateless and HMAC-signed, so changing
# this value invalidates every signed-in admin — which is also how you force a
# sign-out everywhere if a laptop goes missing.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The app refuses to start in production without one. In development a fixed
# fallback is used so a fresh clone runs with no setup.
ADMIN_SESSION_SECRET=

# Public origin, no trailing slash. Used for canonical URLs, the sitemap and Open
# Graph tags. Change the `url` row in Admin → Settings once the store exists rather
# than here on a running install.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Signs customer session cookies. Same construction and same policy as
# ADMIN_SESSION_SECRET, deliberately a different value — a customer token must never
# verify as a staff session or vice versa.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The app refuses to start in production without one. In development a fixed
# fallback is used so a fresh clone runs with no setup.
CUSTOMER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Country code assumed when a shopper types a mobile number with no country code —
# most people type their own number the way they say it out loud, which is the
# national form. See src/lib/phone.ts.
#
# NEXT_PUBLIC_ because the signup form validates as you type and the server
# re-validates before it writes anything; both need the same answer.
#
# Defaults to +91 if unset.
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+91

# ---------------------------------------------------------------------------
# Delhivery Shipping Integration
# ---------------------------------------------------------------------------

# API token from Delhivery dashboard (Settings → API Setup → API Token)
# See: https://help.delhivery.com/docs/api-token-generation
# Server-only — never prefix with NEXT_PUBLIC_
DELHIVERY_API_TOKEN=

# Environment: "staging" for testing, "production" for live shipments
# Staging URL: https://staging-express.delhivery.com
# Production URL: https://track.delhivery.com
DELHIVERY_ENVIRONMENT=staging

# Your registered client name with Delhivery (case-sensitive, must match exactly)
DELHIVERY_CLIENT_NAME=

# Default pickup location name (must match a registered warehouse name exactly)
# This is the warehouse from which most shipments will be picked up
DELHIVERY_DEFAULT_PICKUP_LOCATION=

# Webhook secret for verifying Delhivery webhook signatures (optional but recommended)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELHIVERY_WEBHOOK_SECRET=

# Seller GSTIN, printed on the invoice that travels with the parcel.
#
# Optional. Leave empty if the GST details are registered against your
# Delhivery account — the field is then omitted and Delhivery uses the account
# value. Set it only to override per shipment, and only with your own number.
SELLER_GST_TIN=

# ---------------------------------------------------------------------------
# Transactional email — optional, but nothing is delivered without it
# ---------------------------------------------------------------------------

# Resend API key, from https://resend.com/api-keys
#
# Keep this server-only: never prefix it with NEXT_PUBLIC_ and never commit the real
# value. After changing any environment variable, restart `npm run dev`; deployment
# environments must receive the same values in their own dashboard.
#
# Leave RESEND_API_KEY or EMAIL_FROM unset and the order pipeline still renders and
# records each message at Admin → Email with status "logged", but nothing is delivered.
# The public contact form is stricter: it reports that client care is unavailable rather
# than claiming an enquiry was received when it only reached a local log.
#
# Only Resend is implemented. All sends go through src/server/email/transport.ts.
# RESEND_API_KEY=re_xxxxxxxxx

# Sender shown in the customer's inbox. Required with RESEND_API_KEY.
#
# Before using this address, add its domain in Resend → Domains and complete the DNS
# records Resend supplies. The exact mailbox does not have to exist for sending, but the
# domain must show as verified. Either syntax works:
#
#   EMAIL_FROM=orders@your-domain.com
#   EMAIL_FROM=Prestine <orders@your-domain.com>
#
# Do not use a free Gmail/Yahoo address here. Use a domain you control and have verified.
# Resend's shared onboarding.resend.dev domain works for testing but is not meant for
# production sending.
# EMAIL_FROM=Prestine <orders@your-domain.com>

# Default destination for replies to order/status messages. The public contact form
# overrides this per message so Reply goes to the shopper who submitted the enquiry.
# Use a real monitored inbox on your domain.
# EMAIL_REPLY_TO=hello@your-domain.com

# Contact-form delivery goes to the public store email configured at Admin → Settings,
# not to an address supplied by the browser. Set that field to a real client-care inbox
# before launch. This fixed-recipient design prevents the form becoming an open relay.

# Shared secret for the review-request sweep endpoint.
#
# Review requests are the one email not triggered by someone clicking something — they
# come due on their own, some days after delivery. Nothing wakes a web app up, so
# something has to knock:
#
#   curl -X POST https://your-domain.com/api/email/review-requests \
#     -H "Authorization: Bearer $EMAIL_CRON_SECRET"
#
# Once a day is plenty. Calling it more often is harmless — each order is claimed before
# it is sent, so a second call cannot ask the same customer twice.
#
# Unset, the endpoint returns 503 and refuses to run. It triggers outbound mail to real
# customers, and an unauthenticated URL that does that is an open relay pointed at your
# own order book. Generate one the same way as ADMIN_SESSION_SECRET.
#
# Without either this or a person pressing "Send due requests" in the admin panel, no
# review request is ever sent.
# EMAIL_CRON_SECRET=

# Shared secret for the tracking sweep endpoint.
#
# A parcel moves on its own and nothing wakes a web app up to notice, so the same
# knock-from-outside pattern applies:
#
#   curl -X POST https://your-domain.com/api/shipping/sync-tracking \
#     -H "Authorization: Bearer $SHIPPING_CRON_SECRET"
#
# On Netlify you do not need to run that yourself: netlify/functions/sync-tracking.mts is a
# Scheduled Function that makes this call every 15 minutes, using whichever of
# SHIPPING_CRON_SECRET / EMAIL_CRON_SECRET is set. It only runs on the published
# production deploy, and the variable must be available to the Functions scope in
# Site configuration -> Environment variables. Test it with "Run now" on the Functions page.
#
# Every 15-30 minutes is sensible. Calling it more often is harmless but wastes
# Delhivery request budget — add ?staleMinutes=15 to skip shipments polled recently.
# Scans are deduplicated by a unique index, so repeats cannot grow the history.
#
# Optional: when unset, the endpoint accepts EMAIL_CRON_SECRET instead, so an existing
# deployment needs no new variable. Set this only to keep the two schedules on separate
# credentials. With neither set, the endpoint returns 503 and no tracking is ever fetched.
# SHIPPING_CRON_SECRET=

# Lock the admin panel to specific IP addresses. Comma-separated, no spaces needed.
# Every other address gets a 404 on /admin — including the login form, so an attacker
# cannot reach the password field at all.
#
# Leave unset unless you and your staff work from fixed addresses. Getting it wrong
# locks you out of your own shop: add your address, deploy, confirm you can still sign
# in, and only then depend on it.
#
# Find your address with:  curl https://api.ipify.org
#
# This trusts the x-forwarded-for header. Netlify and Vercel set it reliably. If you
# self-host behind nginx or Caddy, configure the proxy to set it, or a client can
# forge it.
# ADMIN_IP_ALLOWLIST=203.0.113.4,203.0.113.5

# ---------------------------------------------------------------------------
# SMS (signup and password-reset codes) — optional, but nothing is delivered without it
# ---------------------------------------------------------------------------

# 2Factor.in API key, from https://2factor.in — Dashboard → API Keys (create a free
# trial account to get one; it ships with a small OTP balance to test with).
#
# Leave unset and the OTP pipeline still runs: every code is generated, hashed and
# printed to the server console instead of texted. That is deliberate — a developer
# has to be able to complete a signup on a fresh clone with no SMS account at all. The
# console line says plainly that nothing was actually sent.
#
# With it set, 2Factor takes over entirely: it generates the code, texts it, and
# tracks its own expiry and attempt cap — this app never sees a digit and only holds a
# session id (returned by 2Factor's send call) long enough to check the code the
# shopper types back in. See src/server/twofactor.ts.
# TWOFACTOR_API_KEY=

# Name of an APPROVED OTP template from the 2Factor dashboard (SMS OTP → OTP
# Templates → Create New OTP Template). Without this, 2Factor's own routing decides
# the delivery channel per number and can fall back to a voice call instead of an
# SMS — a template name pins delivery to that specific, pre-approved SMS message.
#
# Create one in the dashboard first (a template like "XXXX is your otp for login."
# is approved almost immediately for testing), then paste its exact template name
# here. Leave unset and OTPs still send, just without a guaranteed channel.
# TWOFACTOR_TEMPLATE_NAME=

# ---------------------------------------------------------------------------
# Cashfree Payment Gateway — required to take real payment at checkout
# ---------------------------------------------------------------------------
#
# Without these, checkout still records an order but the card/UPI/netbanking step is
# disabled and `placeOrder` refuses with a clear message rather than pretending to
# charge anyone — see the "no PSP wired up" note that used to live in
# src/app/actions/checkout.ts. This is the one integration this store cannot go live
# without.
#
# Get your keys from the Cashfree Merchant Dashboard → Developers → API Keys.
# https://merchant.cashfree.com/merchants/login
#
# Test in the sandbox first: sandbox and production are two entirely separate
# credential sets, and a sandbox key against the production API (or vice versa) fails
# outright rather than silently charging or refusing the wrong environment.

# "sandbox" while testing, "production" once you are taking real payments. Anything
# else is treated as sandbox so a typo here fails safe rather than accidentally going
# live.
CASHFREE_ENVIRONMENT=sandbox

# App ID (a.k.a. Client ID), from Developers → API Keys. Not secret — Cashfree's own
# client-side SDK snippets show it — but there is no reason to prefix it
# NEXT_PUBLIC_ since only server code (src/server/cashfree.ts) ever sends it.
CASHFREE_APP_ID=

# Secret Key, from the same page. Server-only: it authenticates every order-creation
# call and is also the key webhook signatures are verified against — never expose it
# to the browser and never commit the real value. Rotate it from the dashboard
# immediately if it leaks.
CASHFREE_SECRET_KEY=

# Shared secret Cashfree signs webhook deliveries with. Cashfree does not issue a
# separate value for this — it is the same Secret Key above, kept as its own
# variable so a future account structure (e.g. a different secret per webhook
# endpoint) does not require touching the payment-creation code path too.
#
# Configure the webhook URL in the dashboard under Developers → Webhooks, pointed at:
#   https://your-domain.com/api/payments/cashfree/webhook
# Subscribe at least to the Payment Success, Payment Failed and Payment User Dropped
# events — without them an order can be charged and this app never finds out.
CASHFREE_WEBHOOK_SECRET=

# API version pinned in every request header, per Cashfree's versioning scheme.
# Change only after reading the migration guide for the version you are moving to —
# request/response shapes differ between versions.
# CASHFREE_API_VERSION=2023-08-01
