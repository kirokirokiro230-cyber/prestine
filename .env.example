# Copy to .env.local and fill in. Never commit .env.local.
#
# Every command reads .env.local, then .env, and a real environment variable beats
# both — see scripts/env.ts. That file exists because `next dev` reads .env.local by
# itself and drizzle-kit does not, so without it the migration commands would see an
# empty DIRECT_URL while the dev server in the next terminal connected fine.
#
# ---------------------------------------------------------------------------
# First run, in order
# ---------------------------------------------------------------------------
#
#   1. npm run db:migrate    create the tables
#   2. npm run db:seed       insert the catalogue, taxonomy, banners and settings
#   3. open /admin/setup     create the first owner and choose its password
#
# Step 3 is deliberately not automated: a seeded password would live in the repo, in
# your shell history and in the deploy log, and nobody ever changes it. The setup
# screen locks itself as soon as one account exists.

# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------

# TWO connection strings, and they are not interchangeable. Both come from the
# Supabase dashboard: Project Settings → Database → Connection string.
#
# Getting them the wrong way round fails in two different confusing ways: migrations
# that error on statements the pooler cannot carry, or an application that runs out of
# connections under load hours after it deployed fine.

# The production application connection. Supabase "Transaction pooler", PORT 6543.
#
# A serverless function may be created and destroyed per request, so it cannot hold a
# real Postgres connection — a few hundred concurrent invocations would exhaust the
# database's connection limit. The pooler lends a connection for one transaction.
#
# The app refuses to start in production if this points at 5432. Local development
# prefers DIRECT_URL below, avoiding the pooler's extra hop and stale pooled sessions.
#
# Setting this also switches sign-in rate limiting from an in-process counter to the
# shared login_attempts table. The counter is worse than useless on serverless: five
# guesses can land on five instances that each see an empty count, so the limit never
# triggers while the login form looks protected.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Direct Postgres connection, PORT 5432.
#
# Used by drizzle-kit (npm run db:migrate / db:generate / db:studio), the seed script,
# and the local development server. Migrations need a real session for DDL; local dev is
# one long-running process with one socket and does not need transaction pooling.
# Production never uses this value.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Image storage — required
# ---------------------------------------------------------------------------

# Uploaded photography cannot live on disk on a serverless host, so it goes to
# Supabase Storage. Create a PUBLIC bucket (Storage → New bucket) and name it here.
#
# Public because product photos are public: making the bucket private would mean
# signing every URL, which breaks CDN caching and next/image for no security gain.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=product-images

# The service-role key, NOT the anon key.
#
# Server-only — it bypasses row-level security. It must never appear in a
# NEXT_PUBLIC_* variable, be imported into a client component, or be committed. If it
# leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=

# The anon (public) key. Safe to expose to the browser — Row Level Security policies
# on every table decide what it can actually read or write, not this key's secrecy.
#
# From: Project Settings → API → Project API keys → anon / public.
#
# NEXT_PUBLIC_ because both the browser client and server-rendered pages use it for
# anything a Supabase session (not the service role) should read or write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Signs admin session cookies. Sessions are stateless and HMAC-signed, so changing
# this value invalidates every signed-in admin — which is also how you force a
# sign-out everywhere if a laptop goes missing.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The app refuses to start in production without it. In development a fixed
# fallback is used so a fresh clone runs with no setup.
ADMIN_SESSION_SECRET=

# Public origin, no trailing slash. Used for canonical URLs, the sitemap and Open
# Graph tags. Seeds the store's `url` setting on first run; after that the value in
# Settings wins, so change it there rather than here on a running install.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Signs customer session cookies. Same construction and same policy as
# ADMIN_SESSION_SECRET, deliberately a different value — a customer token must never
# verify as a staff session or vice versa.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The app refuses to start in production without it. In development a fixed
# fallback is used so a fresh clone runs with no setup.
CUSTOMER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Country code assumed when a shopper types a mobile number with no country code —
# most people type their own number the way they say it out loud, which is the
# national form. See src/lib/phone.ts.
#
# NEXT_PUBLIC_ because the signup form validates as you type and the server
# re-validates before it writes anything; both need the same answer.
#
# Defaults to +91 if unset.
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+91

# Delhivery client API token, from the Delhivery dashboard:
# Settings → API Setup → API Token. See https://help.delhivery.com/docs/api-token-generation
#
# Powers the "check delivery to your PIN code" box on the product page. Server-only —
# it is account-scoped and must never appear in a NEXT_PUBLIC_* variable.
#
# What it does and does not do: Delhivery's B2C API reports whether a pincode is
# serviceable and whether cash on delivery is offered there. It does NOT return a
# delivery estimate — there is no TAT endpoint in their B2C set — so the "arrives in N
# days" figure comes from the delivery-days settings in the admin panel, not the courier.
#
# Leave unset and the PIN code box still works: it shows the standard delivery estimate
# and says so, rather than claiming a serviceability check that never happened.
# DELHIVERY_API_TOKEN=

# ---------------------------------------------------------------------------
# Transactional email — optional, but nothing is delivered without it
# ---------------------------------------------------------------------------

# Resend API key, from https://resend.com/api-keys
#
# Keep this server-only: never prefix it with NEXT_PUBLIC_ and never commit the real
# value. After changing any environment variable, restart `npm run dev`; deployment
# environments must receive the same values in their own dashboard.
#
# Leave RESEND_API_KEY or EMAIL_FROM unset and the order pipeline still renders and
# records each message at Admin → Email with status "logged", but nothing is delivered.
# The public contact form is stricter: it reports that client care is unavailable rather
# than claiming an enquiry was received when it only reached a local log.
#
# Only Resend is implemented. All sends go through src/server/email/transport.ts.
# RESEND_API_KEY=re_xxxxxxxxx

# Sender shown in the customer's inbox. Required with RESEND_API_KEY.
#
# Before using this address, add its domain in Resend → Domains and complete the DNS
# records Resend supplies. The exact mailbox does not have to exist for sending, but the
# domain must show as verified. Either syntax works:
#
#   EMAIL_FROM=orders@your-domain.com
#   EMAIL_FROM=Prestine <orders@your-domain.com>
#
# Do not use a free Gmail/Yahoo address here. Use a domain you control and have verified.
# EMAIL_FROM=Prestine <orders@your-domain.com>

# Default destination for replies to order/status messages. The public contact form
# overrides this per message so Reply goes to the shopper who submitted the enquiry.
# Use a real monitored inbox on your domain.
# EMAIL_REPLY_TO=hello@your-domain.com

# Contact-form delivery goes to the public store email configured at Admin → Settings,
# not to an address supplied by the browser. Set that field to a real client-care inbox
# before launch. This fixed-recipient design prevents the form becoming an open relay.

# Shared secret for the review-request sweep endpoint.
#
# Review requests are the one email not triggered by someone clicking something — they
# come due on their own, some days after delivery. Nothing wakes a web app up, so
# something has to knock:
#
#   curl -X POST https://your-domain.com/api/email/review-requests \
#     -H "Authorization: Bearer $EMAIL_CRON_SECRET"
#
# Once a day is plenty. Calling it more often is harmless — each order is claimed before
# it is sent, so a second call cannot ask the same customer twice.
#
# Unset, the endpoint returns 503 and refuses to run. It triggers outbound mail to real
# customers, and an unauthenticated URL that does that is an open relay pointed at your
# own order book. Generate one the same way as ADMIN_SESSION_SECRET.
#
# Without either this or a person pressing "Send due requests" in the admin panel, no
# review request is ever sent.
# EMAIL_CRON_SECRET=

# Lock the admin panel to specific IP addresses. Comma-separated, no spaces needed.
# Every other address gets a 404 on /admin — including the login form, so an attacker
# cannot reach the password field at all.
#
# Leave unset unless you and your staff work from fixed addresses. Getting it wrong
# locks you out of your own shop: add your address, deploy, confirm you can still sign
# in, and only then depend on it.
#
# Find your address with:  curl https://api.ipify.org
#
# This trusts the x-forwarded-for header. Netlify and Vercel set it reliably. If you
# self-host behind nginx or Caddy, configure the proxy to set it, or a client can
# forge it.
# ADMIN_IP_ALLOWLIST=203.0.113.4,203.0.113.5

# ---------------------------------------------------------------------------
# SMS (signup and password-reset codes) — optional, but nothing is delivered without it
# ---------------------------------------------------------------------------

# Twilio credentials, from https://console.twilio.com
#
# Leave everything below unset and the OTP pipeline still runs: every code is
# generated, hashed and printed to the server console instead of texted. That is
# deliberate — a developer has to be able to complete a signup on a fresh clone with
# no Twilio account. The console line says plainly that nothing was actually sent.
#
# The account SID and auth token are shared by both delivery paths below.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# There are two mutually exclusive ways to deliver a code. Set the credentials for
# ONE of them; otp.ts picks the Verify path whenever a Verify Service SID is present.
#
# Path A — Twilio Verify (recommended). A Verify Service (SID starts "VA") generates
# the code, texts it, and tracks its expiry and attempt cap on Twilio's side. This
# app never sees a digit, so there is no From number to set — Twilio owns the sender.
# TWILIO_VERIFY_SERVICE_SID=
#
# Path B — plain SMS. This app generates and hashes the code and hands the text to
# Twilio to send. Set a sender: either a Messaging Service SID (starts "MG") or a
# single number in E.164 that is provisioned on your Twilio account. Set one, not both.
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------

# Where uploaded images are written when running against a local disk rather than
# Supabase Storage. Relative to the project root. The test suite points this at
# .test-store/ so it never touches real files.
# PRESTINE_UPLOAD_DIR=data/uploads
